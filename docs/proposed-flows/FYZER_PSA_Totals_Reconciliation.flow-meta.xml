<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <assignments>
        <name>Add_Entry_To_Totals</name>
        <label>Add Entry To Totals</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varTotalBilled</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Through_Entries.Billable_Amount__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTotalCost</assignToReference>
            <operator>Add</operator>
