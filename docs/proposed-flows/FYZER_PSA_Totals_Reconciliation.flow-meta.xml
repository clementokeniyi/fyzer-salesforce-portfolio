        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Project_Timesheet_Entries</name>
        <label>Get Project Timesheet Entries</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Through_Entries</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Project__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>FYZER_Timesheet_Entry__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Project_Totals</name>
        <label>Update Project Totals</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Total_Billed__c</field>
            <value>
                <elementReference>varTotalBilled</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Total_Cost__c</field>
            <value>
                <elementReference>varTotalCost</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Reset_Totals</targetReference>
        </connector>
        <object>FYZER_Project__c</object>
        <scheduledPaths>
            <frequency>Daily</frequency>
            <label>Daily Reconciliation</label>
            <name>Daily_Reconciliation</name>
            <pathType>Schedule</pathType>
            <startDate>2026-10-21</startDate>
            <startTime>06:00:00.000Z</startTime>
        </scheduledPaths>
        <triggerType>Scheduled</triggerType>
    </start>
