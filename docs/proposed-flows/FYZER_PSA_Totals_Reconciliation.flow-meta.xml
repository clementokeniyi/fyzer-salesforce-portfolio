    <description>QA remediation for TD-1: record-triggered flows on delete are rejected by this org (dry-run validation, both trigger phases, API 68), so timesheet deletions cannot recalculate project totals in real time. This scheduled flow runs nightly per project and recomputes Total Billed / Total Cost from the remaining timesheet entries, reconciling any drift (including from deletions) within 24 hours. Total Hours is a native roll-up and is always current.</description>
    <environments>Default</environments>
    <interviewLabel>FYZER PSA Totals Reconciliation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>FYZER PSA Totals Reconciliation</label>
    <loops>
        <name>Loop_Through_Entries</name>
        <label>Loop Through Entries</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Project_Timesheet_Entries</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Entry_To_Totals</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Project_Totals</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
